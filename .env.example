APP_NAME=khronoz
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:43080
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# Host ports live in a 43xxx block: above the common-port clutter, below
# the 49152+ ephemeral range, and the last digits echo each real port.
SERVER_PORT=43080
VITE_PORT=43173
FORWARD_DB_PORT=43432
FORWARD_VALKEY_PORT=43379
FORWARD_RUSTFS_PORT=43900
FORWARD_RUSTFS_CONSOLE_PORT=43901
FORWARD_MAILPIT_PORT=43025
FORWARD_MAILPIT_DASHBOARD_PORT=43825

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=43432
DB_DATABASE=khronoz
DB_USERNAME=chronoz
DB_PASSWORD=password

# Migrations run as the owner (composer migrate). Required here: the owner
# connection has no fallback credentials. Leave DB_OWNER_* unset where Octane
# and Horizon run — AppServiceProvider refuses to resolve that connection
# outside a console run even if they are set.
DB_OWNER_USERNAME=khronoz
DB_OWNER_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
LARAVEL_PDF_DRIVER=gotenberg
# Use http://gotenberg:3000 from an application on the private Compose network.
GOTENBERG_URL=http://127.0.0.1:43000
DOCUMENT_STORE=archive
DOCUMENT_ARCHIVE_DISK=s3

# Queues and cache live in Valkey; the jobs and cache tables are gone.
# Failed jobs are kept by Horizon in Redis, so the framework's failed_jobs
# table is not used. Set this to database-uuids and restore the migration
# if you want `queue:retry` to work off Postgres instead.
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=null
CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=43379
REDIS_CACHE_DB=1
REDIS_HORIZON_DB=2

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=43025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# RustFS is S3 compatible, so it is driven through the standard s3 disk.
# Create the bucket once at http://localhost:43901 (sail / password).
AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=khronoz
AWS_URL=http://localhost:43900/khronoz
AWS_ENDPOINT=http://localhost:43900
AWS_USE_PATH_STYLE_ENDPOINT=true

# Octane runs on the host; the local PHP already has the swoole extension.
# `php artisan octane:start --watch` to serve through it.
OCTANE_SERVER=swoole
OCTANE_HTTPS=false

# Inertia SSR is off sitewide and opted into per route with route
# metadata (['ssr' => true]). Run the server with:
#   php artisan inertia:start-ssr
INERTIA_SSR_ENABLED=true
INERTIA_SSR_PORT=43714
INERTIA_SSR_URL=http://127.0.0.1:43714
# Inertia falls back to client rendering silently when SSR fails.
# Uncomment to make failures loud while debugging SSR.
# INERTIA_SSR_THROW_ON_ERROR=true

# Scout on the Postgres full-text driver. Swap to meilisearch or typesense
# by adding the service with `sail:add` and changing SCOUT_DRIVER.
SCOUT_DRIVER=database
SCOUT_QUEUE=true

HORIZON_PATH=horizon
HORIZON_REDIS_CONNECTION=horizon

TELESCOPE_ENABLED=true
TELESCOPE_PATH=telescope
TELESCOPE_DB_CONNECTION=telescope

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:43080,localhost:43173,127.0.0.1,127.0.0.1:43080,127.0.0.1:43173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# APPLE_CLIENT_SECRET is a generated ES256 JWT, not a portal string.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/auth/apple/callback"

VITE_APP_NAME="${APP_NAME}"
