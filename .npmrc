ignore-scripts=true
audit=true
# typescript-eslint's published peer range (<6.1.0) hasn't caught up to the
# TypeScript 7 major this project installs; the packages work together for
# npm's own dependency graph in practice, so skip npm's strict peer check
# instead of pinning typescript back. (typescript-eslint's *runtime* refusal
# to load at all under TS 7 is a separate, unresolved problem — see the
# Task 2 report on `npm run lint`.)
legacy-peer-deps=true
