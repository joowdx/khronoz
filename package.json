{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && vite build --ssr",
        "build:client": "vite build",
        "build:ssr": "vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/js",
        "lint": "eslint resources/js",
        "pretypes": "php artisan wayfinder:generate --with-form",
        "types": "npm run pretypes && tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@inertiajs/vite": "^3.7.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.10",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.5.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "axios": "^1.20.0",
        "chokidar": "^5.0.0",
        "concurrently": "^10.0.3",
        "eslint": "^10.10.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.12.0",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/react": "^3.7.0",
        "@tanstack/react-table": "^9.2.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "fontaine": "^0.8.1",
        "lucide-react": "^1.43.0",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.6.7",
        "react": "^19.2.8",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.2.8",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0"
    }
}
