# Build outputs — regenerated inside the image. A stale local copy must never
# shadow the fresh build.
/bootstrap/ssr
/public/build
/public/hot
/public/storage

# Dependencies — installed inside the image against the lockfiles.
/node_modules
/vendor

# Generated by the wayfinder Vite plugin during the build.
/resources/js/actions
/resources/js/routes
/resources/js/wayfinder

# Local development artefacts. telescope.sqlite alone reaches 1.3 GB on a
# working machine, and the Passport keys are secrets the image must never carry
# -- production reads them from PASSPORT_PRIVATE_KEY / PASSPORT_PUBLIC_KEY.
/database/*.sqlite*
/storage/*.key
/storage/inertia-devtools
/storage/pail

# Runtime state. The container starts with an empty storage tree.
/storage/app/private/*
/storage/app/public/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
!/storage/**/.gitignore

# Secrets. Env arrives from the orchestrator, never from a baked file.
.env
.env.*
!.env.example

# Nothing below affects the running application. Two deliberate absences:
# docker/ (the build runs docker/prune.php) and .npmrc (it carries
# legacy-peer-deps, without which `npm ci` cannot resolve this tree at all).
/.git
/.ai
/.agents
/.claude
/.codex
/.cursor
/.serena
/.superpowers
/tests
/docs
compose.yaml
phpunit.xml
eslint.config.js
components.json
.editorconfig
.prettierrc
.phpunit.result.cache
boost.json
opencode.json
.mcp.json
AGENTS.md
CLAUDE.md
README.md
.DS_Store
